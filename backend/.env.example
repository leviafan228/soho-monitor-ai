# Скопіюйте цей файл у .env і заповніть власними значеннями. Файл .env НЕ комітиться.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/soho_monitor
# ≥ 32 випадкові символи: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Перший адміністратор (створюється, якщо в БД немає користувачів)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:3000
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
POLL_INTERVAL_MS=5000
HEARTBEAT_MS=30000
LOG_DIR=./logs
BACKUP_DIR=./backups
BACKUP_KEEP=14
